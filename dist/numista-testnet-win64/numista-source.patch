+TEST(numista_testnet, has_isolated_network_identity)
+{
+    const auto& numista = cryptonote::get_config(cryptonote::TESTNET);
+    const auto& mainnet = cryptonote::get_config(cryptonote::MAINNET);
+    const auto& stagenet = cryptonote::get_config(cryptonote::STAGENET);
+
+    EXPECT_NE(numista.NETWORK_ID, mainnet.NETWORK_ID);
+    EXPECT_NE(numista.NETWORK_ID, stagenet.NETWORK_ID);
+    EXPECT_NE(numista.GENESIS_NONCE, mainnet.GENESIS_NONCE);
+    EXPECT_NE(numista.GENESIS_NONCE, stagenet.GENESIS_NONCE);
+    EXPECT_NE(numista.P2P_DEFAULT_PORT, mainnet.P2P_DEFAULT_PORT);
+    EXPECT_NE(numista.P2P_DEFAULT_PORT, stagenet.P2P_DEFAULT_PORT);
+    EXPECT_NE(numista.CRYPTONOTE_PUBLIC_ADDRESS_BASE58_PREFIX, mainnet.CRYPTONOTE_PUBLIC_ADDRESS_BASE58_PREFIX);
+    EXPECT_NE(numista.CRYPTONOTE_PUBLIC_ADDRESS_BASE58_PREFIX, stagenet.CRYPTONOTE_PUBLIC_ADDRESS_BASE58_PREFIX);
+
+    cryptonote::block numista_genesis;
+    cryptonote::block mainnet_genesis;
+    ASSERT_TRUE(cryptonote::generate_genesis_block(numista_genesis, numista.GENESIS_TX, numista.GENESIS_NONCE));
+    ASSERT_TRUE(cryptonote::generate_genesis_block(mainnet_genesis, mainnet.GENESIS_TX, mainnet.GENESIS_NONCE));
+    EXPECT_NE(cryptonote::get_block_hash(numista_genesis), cryptonote::get_block_hash(mainnet_genesis));
+}
